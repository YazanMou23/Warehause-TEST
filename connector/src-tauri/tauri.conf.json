{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogiFlow Connector",
  "version": "3.0.0",
  "identifier": "de.logiflow.connector",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "LogiFlow GmbH",
    "category": "Utility",
    "shortDescription": "LogiFlow Printer & Scanner Connector",
    "longDescription": "Bridges the LogiFlow web application with local printers and scanners on your network."
  }
}