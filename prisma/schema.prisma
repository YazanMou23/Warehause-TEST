datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MANAGER
  ADMIN
  EMPLOYEE
}

enum ContainerStatus {
  FULL
  EMPTY
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  name         String
  phone        String        @unique
  email        String?       @unique
  profilePhoto String?
  passwordHash String
  role         Role          @default(EMPLOYEE)
  warehouseId  String?
  warehouse    Warehouse?    @relation(fields: [warehouseId], references: [id])
  hallId       String?
  hall         Hall?         @relation(fields: [hallId], references: [id])
  isActive     Boolean       @default(true)
  telegramId   String?       @unique
  employmentStart DateTime?    @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  
  attendance   Attendance[]
  plans        PlanEmployee[]
  actionLogs   ActionLog[]

  @@index([warehouseId])
  @@index([hallId])
}

model Warehouse {
  id         String       @id @default(uuid())
  name       String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  halls      Hall[]
  users      User[]
  containers Container[]
  plans      Plan[]
  attendance Attendance[]
}

model Hall {
  id          String       @id @default(uuid())
  name        String
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  capacity    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  users       User[]
  containers  Container[]
  plans       Plan[]
  attendance  Attendance[]

  @@index([warehouseId])
}

model Container {
  id              String          @id @default(uuid())
  containerNumber String          @unique
  status          ContainerStatus @default(EMPTY)
  warehouseId     String
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  hallId          String
  hall            Hall            @relation(fields: [hallId], references: [id])
  arrivalDate     DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  plans           PlanContainer[]

  @@index([warehouseId])
  @@index([hallId])
  @@index([containerNumber])
}

model Plan {
  id          String          @id @default(uuid())
  title       String?
  description String?
  date        DateTime
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  hallId      String
  hall        Hall            @relation(fields: [hallId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  assignedEmployees  PlanEmployee[]
  assignedContainers PlanContainer[]

  @@unique([date, warehouseId, hallId])
  @@index([date, warehouseId, hallId])
}

model PlanEmployee {
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([planId, employeeId])
}

model PlanContainer {
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@id([planId, containerId])
}

model Attendance {
  id          String     @id @default(uuid())
  employeeId  String
  employee    User       @relation(fields: [employeeId], references: [id])
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  hallId      String
  hall        Hall       @relation(fields: [hallId], references: [id])
  clockIn     DateTime
  clockOut    DateTime?
  totalHours  Float?
  date        DateTime   // Stored as date-only representation (YYYY-MM-DD)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([employeeId, date])
  @@index([warehouseId, date])
}

model ActionLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())

  @@index([timestamp])
}
