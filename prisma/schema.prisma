datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MANAGER
  ADMIN
  EMPLOYEE
}

enum ContainerStatus {
  FULL
  EMPTY
}

enum TimesheetStatus {
  PENDING_REVIEW
  CONFIRMED
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  name         String
  phone        String
  email        String?       @unique
  address      String?
  treffpunkt   String?
  treffpunktTime String?
  profilePhoto String?
  passwordHash String
  role         Role          @default(EMPLOYEE)
  warehouseId  String?
  warehouse    Warehouse?    @relation(fields: [warehouseId], references: [id])
  hallId       String?
  hall         Hall?         @relation(fields: [hallId], references: [id])
  isActive     Boolean       @default(true)
  telegramId   String?       @unique
  employmentStart DateTime?    @default(now())
  employmentEnd   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  
  attendance   Attendance[]
  timesheets   Timesheet[]
  plans        PlanEmployee[]
  actionLogs   ActionLog[]
  passwordResetTokens PasswordResetToken[]
  sentMessages        ChatMessage[] @relation("SentMessages")
  receivedMessages    ChatMessage[] @relation("ReceivedMessages")
  isChatBlocked       Boolean       @default(false)

  // Custom relations
  notifications       Notification[]
  createdContainers   Container[]   @relation("ContainerCreatedBy")
  updatedContainers   Container[]   @relation("ContainerUpdatedBy")
  workedContainers    ContainerEmployee[]

  @@index([warehouseId])
  @@index([hallId])
}

model Warehouse {
  id         String       @id @default(uuid())
  name       String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  halls      Hall[]
  users      User[]
  containers Container[]
  plans      Plan[]
  attendance Attendance[]
}

model Hall {
  id          String       @id @default(uuid())
  name        String
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  capacity    Int?
  color       String?      @default("#1d4ed8")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  users       User[]
  containers  Container[]
  plans       Plan[]
  attendance  Attendance[]

  @@index([warehouseId])
}

model Container {
  id              String          @id @default(uuid())
  containerNumber String
  status          ContainerStatus @default(EMPTY)
  warehouseId     String
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  hallId          String
  hall            Hall            @relation(fields: [hallId], references: [id])
  arrivalDate     DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  // Worked container fields
  workedHours     Float           @default(0)
  notes           String?
  createdById     String?
  createdBy       User?           @relation("ContainerCreatedBy", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?           @relation("ContainerUpdatedBy", fields: [updatedById], references: [id])
  
  employees       ContainerEmployee[]
  plans           PlanContainer[]

  @@index([warehouseId])
  @@index([hallId])
  @@index([containerNumber])
}

model Plan {
  id          String          @id @default(uuid())
  title       String?
  description String?
  date        DateTime
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  hallId      String
  hall        Hall            @relation(fields: [hallId], references: [id])
  shift       String?
  treffpunkt  String?
  treffpunktTime String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  assignedEmployees  PlanEmployee[]
  assignedContainers PlanContainer[]

  @@unique([date, warehouseId, hallId])
  @@index([date, warehouseId, hallId])
}

model PlanEmployee {
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([planId, employeeId])
}

model PlanContainer {
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@id([planId, containerId])
}

model Attendance {
  id          String     @id @default(uuid())
  employeeId  String
  employee    User       @relation(fields: [employeeId], references: [id])
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  hallId      String
  hall        Hall       @relation(fields: [hallId], references: [id])
  clockIn     DateTime
  clockOut    DateTime?
  totalHours  Float?
  date        DateTime   // Stored as date-only representation (YYYY-MM-DD)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Unified fields
  breakMinutes Int       @default(0)
  source       String    @default("MANUAL") // "MANUAL" or "SCAN"
  timesheetId  String?
  timesheet    Timesheet? @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@index([warehouseId, date])
  @@index([timesheetId])
}

model ActionLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── Stundenzettel (Weekly Timesheet) ────────────────────────────────────────

model Timesheet {
  id             String          @id @default(uuid())
  employeeId     String?
  employee       User?           @relation(fields: [employeeId], references: [id])
  employeeName   String          // Raw OCR-erkannter Name (Audit-Trail)
  weekStartDate  DateTime        // Montag der betreffenden Woche (UTC midnight)
  status         TimesheetStatus @default(PENDING_REVIEW)
  createdById    String?         // Manager/Admin der den Scan erstellt hat
  ocrConfidence  String?         // 'exact' | 'fuzzy' | 'none'
  ocrRawResponse Json?           // Komplette GPT-Rohantwort für Debugging
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  entries        TimesheetEntry[]
  attendance     Attendance[]

  @@index([employeeId])
  @@index([weekStartDate])
  @@index([status])
  @@index([createdAt])
}

model TimesheetEntry {
  id           String    @id @default(uuid())
  timesheetId  String
  timesheet    Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  weekday      String    // "Montag", "Dienstag", etc.
  date         DateTime
  startTime    String    // "08:00" — HH:MM 24h Format
  endTime      String?   // "16:30" (optional, null if open shift)
  breakMinutes Int       @default(0)
  totalHours   Float     // Gesamt ohne Pause
  location     String?   // Lagername / Arbeitsort

  @@index([timesheetId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // "PLAN_CREATED" | "PLAN_UPDATED" | "EMPLOYEE_ASSIGNED" | "CONTAINER_UPDATED" | "HOURS_CHANGED" | "ROLE_CHANGED" | "SYSTEM_ALERT"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ContainerEmployee {
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([containerId, employeeId])
}

