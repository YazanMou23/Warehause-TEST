datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MANAGER
  ADMIN
  EMPLOYEE
}

enum ContainerStatus {
  FULL
  EMPTY
}

enum TimesheetStatus {
  PENDING_REVIEW
  CONFIRMED
}

enum DocumentSource {
  SCANNER
  CAMERA
  UPLOAD
  DRAG_AND_DROP
}

enum DocumentStatus {
  CREATED
  UPLOADING
  UPLOADED
  QUEUED
  OCR_PROCESSING
  AI_ANALYZING
  PERSISTING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum BatchStatus {
  DRAFT
  INGESTING
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
}

model User {
  id              String     @id @default(uuid())
  username        String     @unique
  name            String
  phone           String
  email           String?    @unique
  address         String?
  treffpunkt      String?
  treffpunktTime  String?
  profilePhoto    String?
  passwordHash    String
  role            Role       @default(EMPLOYEE)
  warehouseId     String?
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  hallId          String?
  hall            Hall?      @relation(fields: [hallId], references: [id])
  isActive        Boolean    @default(true)
  telegramId      String?    @unique
  employmentStart DateTime?  @default(now())
  employmentEnd   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  attendance          Attendance[]
  timesheets          Timesheet[]
  plans               PlanEmployee[]
  actionLogs          ActionLog[]
  passwordResetTokens PasswordResetToken[]
  sentMessages        ChatMessage[]        @relation("SentMessages")
  receivedMessages    ChatMessage[]        @relation("ReceivedMessages")
  isChatBlocked       Boolean              @default(false)
  hideWorkHours       Boolean              @default(false)

  // Custom relations
  notifications      Notification[]
  createdContainers  Container[]           @relation("ContainerCreatedBy")
  updatedContainers  Container[]           @relation("ContainerUpdatedBy")
  workedContainers   ContainerEmployee[]
  documentBatches    DocumentBatch[]
  universalDocuments UniversalDocument[]
  scannerDevices     ScannerDevice[]
  scanJobs           ScanJob[]
  planSegments       EmployeePlanSegment[] @relation("EmployeePlanSegments")
  absences           EmployeeAbsence[]     @relation("EmployeeAbsences")
  createdAbsences    EmployeeAbsence[]     @relation("AbsenceCreatedBy")

  @@index([warehouseId])
  @@index([hallId])
}

model Warehouse {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  halls         Hall[]
  users         User[]
  containers    Container[]
  planLocations PlanLocation[]
  attendance    Attendance[]
}

model Hall {
  id          String    @id @default(uuid())
  name        String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  capacity    Int?
  color       String?   @default("#1d4ed8")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users         User[]
  containers    Container[]
  planLocations PlanLocation[]
  attendance    Attendance[]

  @@index([warehouseId])
}

model Container {
  id              String          @id @default(uuid())
  containerNumber String
  status          ContainerStatus @default(EMPTY)
  warehouseId     String
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  hallId          String
  hall            Hall            @relation(fields: [hallId], references: [id])
  arrivalDate     DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  // Worked container fields
  workedHours Float   @default(0)
  notes       String?
  createdById String?
  createdBy   User?   @relation("ContainerCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ContainerUpdatedBy", fields: [updatedById], references: [id])

  employees ContainerEmployee[]
  plans     PlanContainer[]

  @@index([warehouseId])
  @@index([hallId])
  @@index([containerNumber])
}

model Plan {
  id             String    @id @default(uuid())
  title          String?
  description    String?
  date           DateTime
  startTime      DateTime  @default(now())
  endTime        DateTime  @default(now())
  shift          String?
  treffpunkt     String?
  treffpunktTime String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  locations          PlanLocation[]
  assignedEmployees  PlanEmployee[]
  assignedContainers PlanContainer[]
  employeeSegments   EmployeePlanSegment[]

  @@index([date])
  @@index([startTime, endTime])
  @@index([deletedAt])
}

model PlanLocation {
  id          String    @id @default(uuid())
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  hallId      String
  hall        Hall      @relation(fields: [hallId], references: [id], onDelete: Restrict)
  startTime   String? // Hall-specific Arbeitsbeginn (e.g. "08:00")
  endTime     String? // Hall-specific Arbeitsende (e.g. "12:00", null if open end)
  isOpenEnd   Boolean   @default(false) // Open end flag for this Hall
  notes       String?

  @@unique([planId, warehouseId, hallId])
  @@index([warehouseId, hallId])
  @@index([planId])
}

model PlanEmployee {
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startTime          DateTime  @default(now())
  endTime            DateTime  @default(now())
  confirmationStatus String    @default("PENDING") // PENDING | CONFIRMED | SICK | CUSTOM_RESPONSE
  responseNote       String?
  respondedAt        DateTime?
  responseChannel    String?

  @@id([planId, employeeId])
  @@index([employeeId, startTime, endTime])
  @@index([planId])
  @@index([confirmationStatus])
}

model PlanContainer {
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@id([planId, containerId])
  @@index([containerId])
  @@index([planId])
}

model Attendance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    User      @relation(fields: [employeeId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  hallId      String
  hall        Hall      @relation(fields: [hallId], references: [id])
  clockIn     DateTime
  clockOut    DateTime?
  totalHours  Float?
  date        DateTime // Stored as date-only representation (YYYY-MM-DD)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Unified fields
  breakMinutes Int        @default(0)
  source       String     @default("MANUAL") // "MANUAL" or "SCAN"
  timesheetId  String?
  timesheet    Timesheet? @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@index([warehouseId, date])
  @@index([timesheetId])
}

model ActionLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── Stundenzettel (Weekly Timesheet) ────────────────────────────────────────

model Timesheet {
  id             String          @id @default(uuid())
  employeeId     String?
  employee       User?           @relation(fields: [employeeId], references: [id])
  employeeName   String // Raw OCR-erkannter Name (Audit-Trail)
  weekStartDate  DateTime // Montag der betreffenden Woche (UTC midnight)
  status         TimesheetStatus @default(PENDING_REVIEW)
  createdById    String? // Manager/Admin der den Scan erstellt hat
  ocrConfidence  String? // 'exact' | 'fuzzy' | 'none'
  ocrRawResponse Json? // Komplette GPT-Rohantwort für Debugging
  uploadJobId    String? // Idempotency: upload job this scan page belongs to
  sourcePage     Int? // Source page number within the upload job (1-based)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  entries    TimesheetEntry[]
  attendance Attendance[]

  @@unique([uploadJobId, sourcePage])
  @@index([employeeId])
  @@index([weekStartDate])
  @@index([status])
  @@index([createdAt])
}

model TimesheetEntry {
  id           String    @id @default(uuid())
  timesheetId  String
  timesheet    Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  weekday      String // "Montag", "Dienstag", etc.
  date         DateTime
  startTime    String // "08:00" — HH:MM 24h Format
  endTime      String? // "16:30" (optional, null if open shift)
  breakMinutes Int       @default(0)
  totalHours   Float // Gesamt ohne Pause
  location     String? // Lagername / Arbeitsort
  isActive     Boolean   @default(true)

  @@index([timesheetId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // "PLAN_CREATED" | "PLAN_UPDATED" | "EMPLOYEE_ASSIGNED" | "CONTAINER_UPDATED" | "HOURS_CHANGED" | "ROLE_CHANGED" | "SYSTEM_ALERT"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ContainerEmployee {
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([containerId, employeeId])
}

// ─── Universal Document Ingestion & Processing System ────────────────────────

model DocumentBatch {
  id             String      @id @default(uuid())
  batchNumber    Int         @default(autoincrement())
  title          String?
  status         BatchStatus @default(DRAFT)
  totalDocuments Int         @default(0)
  completedCount Int         @default(0)
  failedCount    Int         @default(0)
  skippedCount   Int         @default(0)
  createdById    String
  createdBy      User        @relation(fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  documents UniversalDocument[]
  auditLogs DocumentAuditLog[]

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model UniversalDocument {
  id                String         @id @default(uuid())
  batchId           String
  batch             DocumentBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  source            DocumentSource @default(UPLOAD)
  status            DocumentStatus @default(CREATED)
  queuePosition     Int            @default(0)
  originalFileName  String
  mimeType          String
  fileSize          Int            @default(0)
  filePath          String // Original storage path
  processedFilePath String? // Enhanced / perspective corrected / merged storage path
  pageCount         Int            @default(1)

  // Processing lock and worker tracking
  processingAttempts Int       @default(0)
  maxAttempts        Int       @default(3)
  lockWorkerId       String?
  lockedAt           DateTime?
  lockExpiresAt      DateTime?
  idempotencyKey     String    @unique @default(uuid())

  // Extracted Results
  ocrLanguage       String? @default("de")
  ocrRawText        String? @db.Text
  analysisResult    Json? // Full validated structured CRM data (Company, Contact, Invoice, Amounts, Items, Summary)
  matchedEntityType String? // "EMPLOYEE" | "CONTAINER" | "TIMESHEET" | "COMPANY" | "INVOICE"
  matchedEntityId   String?

  errorCode    String?
  errorMessage String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  pages     UniversalDocumentPage[]
  auditLogs DocumentAuditLog[]

  @@index([batchId, queuePosition])
  @@index([status])
  @@index([lockWorkerId, lockExpiresAt])
}

model UniversalDocumentPage {
  id            String            @id @default(uuid())
  documentId    String
  document      UniversalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int
  originalPath  String
  processedPath String?
  width         Int?
  height        Int?
  ocrText       String?           @db.Text
  createdAt     DateTime          @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

model DocumentAuditLog {
  id         String             @id @default(uuid())
  batchId    String?
  batch      DocumentBatch?     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  documentId String?
  document   UniversalDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String?
  event      String // "BATCH_CREATED" | "DOCUMENT_QUEUED" | "OCR_STARTED" | "OCR_COMPLETED" | "AI_ANALYZED" | "PERSISTED" | "COMPLETED" | "FAILED" | "RETRIED" | "SKIPPED"
  details    Json?
  timestamp  DateTime           @default(now())

  @@index([batchId])
  @@index([documentId])
  @@index([timestamp])
}

// ─── Scanner Device Registry ─────────────────────────────────────────────────

/// Persists discovered/connected network and USB scanners per user.
/// IP is stored as lastKnownIp — not used as the primary identifier.
model ScannerDevice {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable identifier derived from serial number or device model+IP combo
  deviceIdentifier String
  manufacturer     String?
  model            String?
  deviceName       String

  /// Last known network location — updated on each discovery
  lastKnownIp String?
  port        Int?    @default(80)

  /// "ESCL" | "WIA" | "SIMULATOR" | "IPP"
  protocol String @default("ESCL")

  /// Full capability set from eSCL ScannerCapabilities XML
  capabilities Json?

  isScanner  Boolean @default(true)
  isPrinter  Boolean @default(false)
  hasAdf     Boolean @default(false)
  hasFlatbed Boolean @default(true)

  /// "UNKNOWN" | "READY" | "BUSY" | "OFFLINE" | "ERROR"
  status      String   @default("UNKNOWN")
  isConnected Boolean  @default(false)
  lastSeen    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanJobs ScanJob[]

  @@unique([userId, deviceIdentifier])
  @@index([userId])
  @@index([deviceIdentifier])
  @@index([isConnected])
}

/// Tracks a single scan job lifecycle (one or many ADF pages).
model ScanJob {
  id       String         @id @default(uuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String?
  device   ScannerDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  /// Linked document batch created from this scan
  batchId String?

  /// QUEUED | CONNECTING | SCANNING | UPLOADING | PROCESSING | COMPLETED | FAILED | CANCELLED
  status String @default("QUEUED")

  /// Scan settings used
  inputSource String  @default("Platen")
  colorMode   String  @default("Grayscale")
  dpi         Int     @default(300)
  format      String  @default("jpeg")
  batchScan   Boolean @default(false)

  /// Progress tracking
  totalPages     Int @default(0)
  processedPages Int @default(0)

  errorMessage String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

// ─── Absence Status Enum ─────────────────────────────────────────────────────

enum AbsenceStatus {
  NICHT_GEARBEITET
  KRANK
  ABWESEND_GRUND
}

// ─── Employee Plan Segments (Individual Treffpunkt & Time Segments) ──────────

model EmployeePlanSegment {
  id             String   @id @default(uuid())
  employeeId     String
  employee       User     @relation("EmployeePlanSegments", fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime // Normalized UTC midnight date (YYYY-MM-DD)
  planId         String?
  plan           Plan?    @relation(fields: [planId], references: [id], onDelete: Cascade)
  treffpunkt     String // e.g. "Büro", "Baustelle A", "Adresse B"
  treffpunktTime String? // "07:45" (Treffzeit - strictly excluded from working hours)
  startTime      String // "08:00" (Arbeitsbeginn)
  endTime        String? // "10:00" (Arbeitsende)
  notes          String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId, date])
  @@index([planId])
  @@index([date])
}

// ─── Employee Absence / Status Tracking ──────────────────────────────────────

model EmployeeAbsence {
  id          String        @id @default(uuid())
  employeeId  String
  employee    User          @relation("EmployeeAbsences", fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime // Normalized UTC midnight date (YYYY-MM-DD)
  status      AbsenceStatus @default(NICHT_GEARBEITET)
  reason      String? // "Arzttermin", "Privater Termin", "Behördentermin", "Urlaub", "Sonstiger Grund", etc.
  notes       String?
  createdById String?
  createdBy   User?         @relation("AbsenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([date])
}

// ─── System Settings & Operational Feature Flags ─────────────────────────────

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}
